ARO_MODEL_PROVIDER=mock
ARO_MODEL_ID=gemma-local
ARO_OLLAMA_ENDPOINT=http://127.0.0.1:11434
ARO_LLAMA_CPP_ENDPOINT=http://127.0.0.1:8080
ARO_VECTOR_MEMORY_MODE=auto
ARO_QDRANT_URL=http://127.0.0.1:6334
ARO_QDRANT_API_KEY=
ARO_EMBEDDING_PROVIDER=ollama
ARO_EMBEDDING_MODEL=nomic-embed-text
ARO_VECTOR_TIMEOUT_MS=5000
ARO_API_BASE_URL=http://127.0.0.1:8710
ARO_ENV=development
ARO_DEPLOYMENT_MODE=local-dev
ARO_SIGNUP_MODE=open
ARO_API_BIND=127.0.0.1:8710
ARO_CORS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
ARO_HTTP_MAX_BODY_BYTES=1048576
ARO_HTTP_MAX_CONCURRENCY=256
ARO_HTTP_REQUEST_TIMEOUT_SECONDS=30
ARO_FILES_API=true
ARO_FILE_STORAGE_BACKEND=s3
ARO_FILE_LOCAL_ROOT=.aro-files
ARO_FILE_MAX_BYTES=52428800
ARO_FILE_ALLOWED_MIME=text/plain,text/markdown,text/csv,application/json,application/pdf,image/png,image/jpeg,image/webp
# Optional locally. Without a reachable clamd service, uploaded files remain pending.
ARO_FILE_SCAN_REQUIRED=false
ARO_CLAMAV_ADDRESS=
ARO_FILE_SCAN_TIMEOUT_SECONDS=90
ARO_FILE_SCAN_LEASE_SECONDS=120
ARO_FILE_SCAN_MAX_ATTEMPTS=3
# Maximum jobs processed per worker cycle; each job receives a fresh lease just before scanning.
ARO_FILE_SCAN_BATCH_SIZE=10
ARO_S3_ENDPOINT=http://127.0.0.1:9000
ARO_S3_BUCKET=aro-files-dev
ARO_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
ARO_AUTO_MIGRATE=true
ARO_LOG_FORMAT=pretty
ARO_PUBLIC_BASE_URL=http://127.0.0.1:8710
ARO_JWT_ISSUER=aro-api
ARO_JWT_AUDIENCE=aro-desktop
ARO_JWT_KEY_ID=dev-v1
ARO_SECRET_PROVIDER=local-key
ARO_REDIS_URL=redis://127.0.0.1:6379/0
ARO_REDIS_KEY_PREFIX=aro:development
ARO_RATE_LIMIT_ENABLED=true
ARO_RATE_LIMIT_AUTH_PER_MINUTE=10
ARO_RATE_LIMIT_WRITE_PER_MINUTE=120
ARO_RATE_LIMIT_ASSISTANT_PER_MINUTE=30
ARO_TRUST_PROXY_HEADERS=false
# Agent web access is an explicit egress capability, disabled by default.
ARO_AGENT_WEB_ACCESS=false
# Direct tool calls bypass the durable execution service. Keep disabled except for a controlled,
# user-approved workflow with a persisted permission profile.
ARO_AGENT_DIRECT_TOOL_EXECUTION=false
ARO_OUTBOX_STREAM_ENABLED=true
ARO_OUTBOX_STREAM_KEY=aro:development:outbox
ARO_OUTBOX_BATCH_SIZE=50
ARO_OUTBOX_LEASE_SECONDS=60
ARO_IDEMPOTENCY_PURGE_BATCH=1000
ARO_REFRESH_TOKEN_FAMILY_PURGE_BATCH=1000
ARO_REFRESH_TOKEN_FAMILY_RETENTION_DAYS=30
DATABASE_URL=postgres://aro:aro@127.0.0.1:5432/aro
ARO_JWT_SECRET=dev-jwt-secret-0123456789-abcdefghijklmnopqrstuvwxyz
ARO_SECRETS_KEY=dev-secrets-key-0123456789-abcdefghijklmnopqrstuvwxyz
ARO_ACCESS_TOKEN_MINUTES=15
ARO_REFRESH_TOKEN_DAYS=30
ARO_REFRESH_TOKEN_FAMILY_DAYS=90
ARO_INVITATION_TTL_HOURS=168
# Keep disabled until a trusted server-side mail delivery worker is attached. Invitation bearer
# tokens are never returned to tenant administrators.
ARO_INVITATION_DELIVERY_ENABLED=false
ARO_INVITATION_ACCEPT_BASE_URL=http://127.0.0.1:1420/
ARO_INVITATION_DELIVERY_BATCH_SIZE=20
ARO_INVITATION_DELIVERY_MAX_ATTEMPTS=5
ARO_INVITATION_DELIVERY_LEASE_SECONDS=60
# When delivery is enabled, use a TLS relay and keep its password worker-only.
ARO_SMTP_RELAY=smtp.example.com
ARO_SMTP_PORT=587
ARO_SMTP_TLS_MODE=starttls
ARO_SMTP_TIMEOUT_SECONDS=30
ARO_SMTP_FROM="ARO <no-reply@example.com>"
ARO_SMTP_USERNAME=
ARO_SMTP_PASSWORD=
ARO_SMTP_ALLOW_UNAUTHENTICATED=false
# Integrations remain off until a real provider configuration and vault review are complete.
ARO_INTEGRATIONS_API_V2=false
ARO_INTEGRATIONS_OAUTH_CONNECT=false
ARO_INTEGRATIONS_API_V3=false
ARO_INTEGRATIONS_WORKERS=false
ARO_INTEGRATIONS_WEBHOOKS=false
ARO_INTEGRATIONS_EXECUTE=false
ARO_INTEGRATIONS_THIRD_PARTY_NETWORK=false
ARO_INTEGRATION_JOB_BATCH_SIZE=20
ARO_INTEGRATION_JOB_LEASE_SECONDS=60
# local-key is development-only. Production v3 startup/readiness requires aws-kms or vault-transit.
# ARO_SECRET_PROVIDER=aws-kms
# ARO_KMS_KEY_ID=arn:aws:kms:eu-west-1:000000000000:key/replace-me
# ARO_KMS_KEY_VERSION=managed
# ARO_KMS_ENDPOINT=
# ARO_SECRET_PROVIDER=vault-transit
# ARO_VAULT_ADDR=https://vault.internal/
# ARO_VAULT_TRANSIT_MOUNT=transit
# ARO_VAULT_TRANSIT_KEY=aro-integrations
# ARO_VAULT_TOKEN=provided-by-workload-identity

# Commercial rollout: keep disabled until contracts and test-mode payment QA are complete.
# See docs/COMMERCIALIZATION.md. Never put provider secrets in VITE_* variables.
ARO_BILLING_ENABLED=false
ARO_COMMERCIAL_TERMS_APPROVED=false
ARO_COMMERCIAL_ENFORCEMENT=false
ARO_STRIPE_SECRET_KEY=
ARO_STRIPE_WEBHOOK_SECRET=
ARO_STRIPE_PRICE_CLOUD=
ARO_STRIPE_PRICE_BUSINESS=
ARO_BILLING_RETURN_URL=
ARO_SALES_EMAIL=
ARO_COMPUTE_ENABLED=false
ARO_COMPUTE_BASE_URL=
ARO_COMPUTE_UPSTREAM_KEY=
ARO_COMPUTE_MODELS_JSON=[]
