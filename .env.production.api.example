# API-only secrets. Use a restricted aro_app database role that owns no tables.
DATABASE_URL=postgres://aro_app:replace-with-api-password@postgres:5432/aro
ARO_JWT_SECRET=replace-with-64-plus-random-characters
ARO_SECRETS_KEY=replace-with-64-plus-random-characters
ARO_METRICS_TOKEN=replace-with-independent-random-bearer-token

# Prefer a separate S3 identity restricted to the API file operations.
AWS_ACCESS_KEY_ID=replace-with-api-minimum-privilege-access-key
AWS_SECRET_ACCESS_KEY=replace-with-api-minimum-privilege-secret-key

# Required only when ARO_PASSWORD_RESET_DELIVERY_ENABLED=true.
# The shared SMTP host, port, sender and acceptance URL live in .env.production.
ARO_SMTP_USERNAME=replace-with-smtp-username
ARO_SMTP_PASSWORD=replace-with-smtp-password

# Required only when billing is enabled after the staging payment checks.
# ARO_STRIPE_SECRET_KEY=replace-with-stripe-secret
# ARO_STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
