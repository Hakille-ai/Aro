ARO_ENV=production
ARO_DEPLOYMENT_MODE=self-host
# Pin every production image to an immutable digest before deployment.
ARO_API_IMAGE=ghcr.io/example/aro-api@sha256:replace-with-published-digest
ARO_POSTGRES_IMAGE=postgres:16@sha256:replace-with-reviewed-digest
ARO_REDIS_IMAGE=redis:7-alpine@sha256:replace-with-reviewed-digest
ARO_CLAMAV_IMAGE=clamav/clamav:1.5.3@sha256:replace-with-reviewed-digest
ARO_CADDY_IMAGE=caddy:2-alpine@sha256:replace-with-reviewed-digest
ARO_SIGNUP_MODE=closed
ARO_PUBLIC_BASE_URL=https://aro.example.com
ARO_DOMAIN=aro.example.com
ARO_ADMIN_EMAIL=admin@example.com
ARO_API_BIND=0.0.0.0:8710
ARO_CORS_ALLOWED_ORIGINS=https://aro.example.com
ARO_TRUST_PROXY_HEADERS=true
ARO_AGENT_WEB_ACCESS=false
ARO_AGENT_DIRECT_TOOL_EXECUTION=false
ARO_HTTP_MAX_BODY_BYTES=1048576
ARO_HTTP_MAX_CONCURRENCY=256
ARO_HTTP_REQUEST_TIMEOUT_SECONDS=30
ARO_DB_MAX_CONNECTIONS=20
ARO_AUTO_MIGRATE=false
ARO_LOG_FORMAT=json
ARO_JWT_ISSUER=aro-api
ARO_JWT_AUDIENCE=aro-desktop
ARO_JWT_KEY_ID=local-v1
ARO_SECRET_PROVIDER=local-key
ARO_ACCESS_TOKEN_MINUTES=15
ARO_REFRESH_TOKEN_DAYS=30
ARO_REFRESH_TOKEN_FAMILY_DAYS=90
ARO_INVITATION_TTL_HOURS=168
# Fail closed until a trusted server-side invitation mail worker is deployed.
ARO_INVITATION_DELIVERY_ENABLED=false
ARO_INVITATION_ACCEPT_BASE_URL=https://aro.example.com/
ARO_INVITATION_DELIVERY_BATCH_SIZE=20
ARO_INVITATION_DELIVERY_MAX_ATTEMPTS=5
ARO_INVITATION_DELIVERY_LEASE_SECONDS=60
ARO_SMTP_RELAY=smtp.internal.example.com
ARO_SMTP_PORT=587
ARO_SMTP_TLS_MODE=starttls
ARO_SMTP_TIMEOUT_SECONDS=30
ARO_SMTP_FROM="ARO <no-reply@example.com>"
ARO_SMTP_ALLOW_UNAUTHENTICATED=false
ARO_REDIS_URL=redis://redis:6379/0
ARO_REDIS_KEY_PREFIX=aro:production
ARO_RATE_LIMIT_ENABLED=true
ARO_RATE_LIMIT_AUTH_PER_MINUTE=10
ARO_RATE_LIMIT_WRITE_PER_MINUTE=120
ARO_RATE_LIMIT_ASSISTANT_PER_MINUTE=30
ARO_OUTBOX_STREAM_ENABLED=true
ARO_OUTBOX_STREAM_KEY=aro:production:outbox
ARO_OUTBOX_BATCH_SIZE=50
ARO_OUTBOX_LEASE_SECONDS=60
ARO_IDEMPOTENCY_PURGE_BATCH=1000
ARO_REFRESH_TOKEN_FAMILY_PURGE_BATCH=1000
ARO_REFRESH_TOKEN_FAMILY_RETENTION_DAYS=30
# The Files API requires a private, durable S3-compatible object store in production.
ARO_FILES_API=true
ARO_FILE_STORAGE_BACKEND=s3
ARO_S3_ENDPOINT=https://s3.example.com
ARO_S3_BUCKET=aro-files-production
ARO_S3_REGION=us-east-1
# ARO starts only when uploads are held behind a real ClamAV worker in production.
ARO_FILE_SCAN_REQUIRED=true
# Private clamd service; never publish this port through the public proxy.
ARO_CLAMAV_ADDRESS=clamav:3310
ARO_FILE_SCAN_TIMEOUT_SECONDS=90
ARO_FILE_SCAN_LEASE_SECONDS=120
ARO_FILE_SCAN_MAX_ATTEMPTS=3
# Per-cycle work limit. Jobs are leased one at a time immediately before their scan.
ARO_FILE_SCAN_BATCH_SIZE=10
# Integrations are deny-by-default. Enable only after configuring each provider's credentials.
ARO_INTEGRATIONS_API_V2=false
ARO_INTEGRATIONS_OAUTH_CONNECT=false
RUST_LOG=aro_api=info,tower_http=info
