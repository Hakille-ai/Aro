# Worker-only credentials. aro_worker must be NOSUPERUSER, NOBYPASSRLS, and own no tables.
ARO_WORKER_DATABASE_URL=postgres://aro_worker:replace-with-worker-password@postgres:5432/aro

# Required only when ARO_INVITATION_DELIVERY_ENABLED=true. Use the same encryption key as the API
# to decrypt a leased bearer token inside worker memory; SMTP credentials must remain worker-only.
ARO_SECRETS_KEY=replace-with-the-same-64-plus-random-characters-as-api
ARO_SMTP_USERNAME=replace-with-smtp-username
ARO_SMTP_PASSWORD=replace-with-smtp-password

# Prefer a separate S3 identity restricted to object reads/quarantine writes needed by scanners.
AWS_ACCESS_KEY_ID=replace-with-worker-minimum-privilege-access-key
AWS_SECRET_ACCESS_KEY=replace-with-worker-minimum-privilege-secret-key

# Enable only after the corresponding certified connectors have passed staging canaries.
ARO_INTEGRATIONS_WORKERS=false
ARO_INTEGRATION_JOB_BATCH_SIZE=20
ARO_INTEGRATION_JOB_LEASE_SECONDS=60
ARO_SECRET_PROVIDER=aws-kms
ARO_KMS_KEY_ID=arn:aws:kms:eu-west-1:000000000000:key/replace-me
ARO_KMS_KEY_VERSION=managed
