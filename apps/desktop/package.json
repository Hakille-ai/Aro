{
  "name": "@aro/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "predev": "powershell -ExecutionPolicy Bypass -File ../../scripts/free-dev-port.ps1 -Port 1420",
    "dev": "vite --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:frontend": "npm run test:unit && npm run test:components && npm run test:e2e",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@lucide/svelte": "^1.21.0",
    "@tauri-apps/api": "^2.0.0",
    "chart.js": "^4.4.0",
    "marked": "^18.0.5",
    "mermaid": "^11.4.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
