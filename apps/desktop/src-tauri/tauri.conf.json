{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARO",
  "version": "0.1.0",
  "identifier": "com.aro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARO",
        "width": 1180,
        "height": 820,
        "minWidth": 940,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://127.0.0.1:* http://localhost:*; img-src 'self' asset: data:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aro"]
      }
    }
  }
}
